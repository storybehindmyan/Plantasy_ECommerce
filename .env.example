# ─── Local dev server ────────────────────────────────────────────────────────
PORT=3000

# ─── Vite / Frontend ─────────────────────────────────────────────────────────
# Leave blank in local dev (Vite proxy forwards /api → localhost:3000)
# Set to your Firebase Functions URL in production
VITE_API_URL=

# Public Razorpay key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# ─── Razorpay (backend / Firebase Functions) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Delhivery ───────────────────────────────────────────────────────────────
# Set USE_MOCK_DELIVERY=true to skip real Delhivery calls in development
DELHIVERY_API_KEY=your_delhivery_api_key
DELHIVERY_BASE_URL=https://ltl-clients-api.delhivery.com
USE_MOCK_DELIVERY=false

# Default package weight in kg (used when creating shipments)
DEFAULT_PACKAGE_WEIGHT=0.5

# Warehouse / pickup location — must match exactly in Delhivery portal
WAREHOUSE_NAME=Plantasy
WAREHOUSE_PHONE=9999999999
WAREHOUSE_ADDRESS_LINE1=Your Address Line 1
WAREHOUSE_ADDRESS_LINE2=Your Address Line 2
WAREHOUSE_CITY=Hyderabad
WAREHOUSE_STATE=Telangana
WAREHOUSE_PINCODE=500001
WAREHOUSE_CLIENT_CODE=YOUR_CLIENT_CODE

# ─── WhatsApp Business API (Meta) ────────────────────────────────────────────
# Leave blank to run in mock mode (logs to console instead of sending)
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Token used to verify the Meta webhook subscription
WHATSAPP_VERIFY_TOKEN=plantasy_verify

# ─── Resend (transactional email) ────────────────────────────────────────────
# Sign up free at https://resend.com — 3,000 emails/month, no credit card
# Leave blank to disable email notifications (logs to console only)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender address — must be verified in Resend dashboard
# Domain plantasy.co.in is verified in Resend dashboard
RESEND_FROM_EMAIL=Plantasy <orders@plantasy.co.in>

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
# Not needed locally — Firebase CLI handles this automatically.
# For CI/CD set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
