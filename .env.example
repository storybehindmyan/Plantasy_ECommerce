PORT=5000
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NODE_ENV=production

# Frontend Razorpay Key (public, safe to expose)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Set your production API URL here
VITE_API_URL=https://your-api-domain.com

DELHIVERY_API_KEY=your_delhivery_api_key
DELHIVERY_BASE_URL=https://ltl-clients-api-dev.delhivery.com
USE_MOCK_DELIVERY=true
WAREHOUSE_NAME=Your Warehouse Name
WAREHOUSE_PHONE=9999999999
WAREHOUSE_ADDRESS_LINE1=Your Address Line 1
WAREHOUSE_ADDRESS_LINE2=Your Address Line 2
WAREHOUSE_CITY=Your City
WAREHOUSE_STATE=Your State
WAREHOUSE_PINCODE=000000
WAREHOUSE_CLIENT_CODE=YOUR_WAREHOUSE_CODE
